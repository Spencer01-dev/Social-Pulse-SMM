# ==============================================
# SocialPulse SMM Reseller Platform - Environment Config
# ==============================================

# Application
PROJECT_NAME=SocialPulse
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_very_secure_random_secret_in_production_socialpulse_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=socialpulse_user
POSTGRES_PASSWORD=socialpulse_password
POSTGRES_DB=socialpulse_db
DATABASE_URL=postgresql+asyncpg://socialpulse_user:socialpulse_password@localhost:5432/socialpulse_db
SYNC_DATABASE_URL=postgresql://socialpulse_user:socialpulse_password@localhost:5432/socialpulse_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Delix Gains KE Provider API
DELIX_API_URL=https://delixgainske.com/api/v2
DELIX_API_KEY=YOUR_DELIX_API_KEY_HERE
USE_MOCK_PROVIDERS=False

# Payment Provider - M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_SHORTCODE=174379
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/payments/mpesa/callback

# Payment Provider - Paystack
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY

# Currency & Exchange Rates
PRIMARY_CURRENCY=KES
DEFAULT_USD_TO_KES=130.00
EXCHANGE_RATE_MARKUP_PERCENT=2.0

# Notifications & SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=notifications@socialpulse.io
EMAIL_PASSWORD=app_specific_password_here
EMAIL_FROM=SocialPulse Support <support@socialpulse.io>
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
